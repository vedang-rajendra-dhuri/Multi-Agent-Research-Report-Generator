APP_ENV=development
DATABASE_URL=postgresql+psycopg://researchpilot:researchpilot-local@db:5432/researchpilot
DATABASE_SSLMODE=disable    
DATABASE_SSLMODE=disable
POSTGRES_DB=researchpilot
POSTGRES_USER=researchpilot
POSTGRES_PASSWORD=researchpilot-local
SECRET_KEY=replace-with-at-least-32-random-characters
CORS_ORIGINS=["http://localhost:5173"]
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Required to queue research tasks; at least one supported LLM and Tavily search are needed.
LLM_PROVIDER=
OPENAI_API_KEY=
GEMINI_API_KEY=
SEARCH_PROVIDER=
SEARCH_PROVIDER_API_KEY=
LLM_MODEL=
MAX_RESEARCH_ITERATIONS=2
MAX_SEARCH_RESULTS=8
PROVIDER_TIMEOUT_SECONDS=60
WORKER_POLL_SECONDS=2
